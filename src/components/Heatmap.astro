---
// Interactive heatmap of GPU memory vs. compute use, built as a real
// <table> so screen readers can read every value.
import { HEATMAP, CLUSTER_STUDY } from '../data/research';
const max = Math.max(...HEATMAP.rows.flatMap((r) => r.values));
// Show the busiest compute row at the top.
const rows = [...HEATMAP.rows].reverse();
---
<figure class="heatmap">
  <div class="frame">
    <p class="axis-y" aria-hidden="true">Average GPU compute use →</p>
    <div class="table-scroll">
      <table>
        <caption class="sr-only">
          Share of {CLUSTER_STUDY.gpuHours} profiled GPU-hours by peak GPU memory (columns) and average GPU compute use (rows).
        </caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Compute use</span></th>
            {HEATMAP.bands.map((b) => <th scope="col">{b}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.compute}</th>
              {row.values.map((v, i) => {
                const t = v / max;
                const key = row.compute === '75–100%' && i === 0;
                return (
                  <td
                    tabindex="0"
                    class:list={{ key, light: t > 0.45 }}
                    style={`--t:${t.toFixed(3)}`}
                    data-text={`${v.toFixed(1)}% of GPU-hours had ${row.compute} average compute use and peaked at ${HEATMAP.bands[i]} of GPU memory.`}
                  >
                    {v.toFixed(1)}%
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="axis-x" aria-hidden="true">Peak GPU memory, as a share of capacity →</p>
  </div>
  <p class="readout" aria-live="polite">
    <strong>Hover over or tap a cell to see its details.</strong> The highlighted cell shows the opportunity: <strong>21.7%</strong> of GPU-hours kept compute 75–100% busy while using a quarter of memory or less.
  </p>
  <figcaption class="caption">
    Source: Cleanroom analysis of {CLUSTER_STUDY.description}, {CLUSTER_STUDY.period}. {CLUSTER_STUDY.gpuHours} paired GPU-hours (peak memory, time-averaged compute).
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.heatmap').forEach((fig) => {
    const out = fig.querySelector('.readout');
    const initial = out?.innerHTML ?? '';
    fig.querySelectorAll<HTMLElement>('td[data-text]').forEach((cell) => {
      const show = () => { if (out) out.textContent = cell.dataset.text ?? ''; };
      cell.addEventListener('mouseenter', show);
      cell.addEventListener('focus', show);
      cell.addEventListener('click', show);
    });
    fig.querySelector('table')?.addEventListener('mouseleave', () => { if (out) out.innerHTML = initial; });
  });
</script>

<style>
  .heatmap { max-width: 44rem; }
  .frame { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; gap: 0.5rem 0.75rem; }
  .axis-y { writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; font-size: 0.8rem; color: var(--on-dark-2, var(--ink-3)); }
  .axis-x { grid-column: 2; text-align: center; font-size: 0.8rem; color: var(--on-dark-2, var(--ink-3)); padding-left: 4.5rem; }
  .table-scroll { overflow-x: auto; }
  table { border-collapse: separate; border-spacing: 4px; width: 100%; min-width: 22rem; }
  th, td { border: 0; padding: 0; }
  thead th { background: none; text-align: center; padding-bottom: 0.4rem; font-size: 0.78rem; letter-spacing: 0.02em; text-transform: none; color: inherit; opacity: 0.75; font-weight: 500; }
  tbody th { font-size: 0.78rem; font-weight: 500; opacity: 0.75; white-space: nowrap; padding-right: 0.5rem; text-align: right; width: 4rem; }
  td {
    height: clamp(3.2rem, 8vw, 4.4rem);
    text-align: center; font-variant-numeric: tabular-nums; font-size: 0.95rem; font-weight: 600;
    border-radius: 8px;
    color: var(--on-dark);
    background: color-mix(in srgb, #5cd1c4 calc(var(--t) * 100%), #172a42);
    cursor: default;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  td.light { color: #062521; }
  td:hover, td:focus-visible { transform: scale(1.04); box-shadow: 0 0 0 2px var(--on-dark); outline: none; }
  td.key { box-shadow: 0 0 0 2px var(--dark), 0 0 0 4px #ffffff; }
  @media (max-width: 600px) {
    .frame { grid-template-columns: 1fr; }
    .axis-y { display: none; }
    .axis-x { grid-column: 1; padding-left: 2.5rem; }
    table { min-width: 0; border-spacing: 3px; }
    td { font-size: 0.8rem; height: 3rem; border-radius: 6px; }
    thead th, tbody th { font-size: 0.68rem; }
    tbody th { width: auto; padding-right: 0.25rem; }
  }
  .readout { margin-top: 1.25rem; min-height: 3.2em; color: var(--on-dark, var(--ink)); }
  .caption { margin-top: 0.75rem; }
</style>
