---
// Mailing-list signup. Submissions go to Netlify (Forms → "updates").
// It works without any JavaScript.
interface Props { id: string; dark?: boolean }
const { id, dark = false } = Astro.props;
const inputId = `updates-email-${id}`;
---
<form
  class:list={['newsletter', { dark }]}
  name="updates"
  method="POST"
  action="/subscribed/"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="updates" />
  <p class="hidden-field" aria-hidden="true">
    <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>
  <label for={inputId} class="sr-only">Email address</label>
  <input id={inputId} class="input" type="email" name="email" required maxlength="200" autocomplete="email" placeholder="you@example.org" />
  <button class="btn btn--primary" type="submit">Subscribe</button>
</form>

<style>
  .newsletter { display: flex; gap: 0.6rem; flex-wrap: wrap; max-width: 30rem; }
  .newsletter .input { flex: 1 1 14rem; }
  .newsletter.dark .input { background: rgb(255 255 255 / 0.06); border-color: rgb(231 237 245 / 0.22); color: var(--on-dark); }
  .newsletter.dark .input::placeholder { color: var(--on-dark-2); }
  .newsletter.dark .input:focus { border-color: var(--accent-on-dark); box-shadow: 0 0 0 3px rgb(92 209 196 / 0.2); }
  .newsletter.dark .btn--primary { background: var(--accent-on-dark); color: var(--dark); }
  .newsletter.dark .btn--primary:hover { background: #8fe3d9; }
</style>
