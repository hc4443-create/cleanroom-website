---
import Logo from './Logo.astro';
import { SITE } from '../config';
const year = new Date().getFullYear();
// A mailing-list signup used to sit here. To bring it back, see
// src/components/NewsletterForm.astro (the form itself is kept for later).

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'How it works', href: '/how-it-works/' },
      { label: 'Host-job safety', href: '/how-it-works/#safety' },
      { label: 'Open source', href: '/open-source/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Research', href: '/research/' },
      { label: 'FAQ', href: '/how-it-works/#faq' },
      ...(SITE.github ? [{ label: 'GitHub', href: SITE.github }] : []),
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Privacy', href: '/privacy/' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Logo />
        <p>{SITE.tagline}</p>
      </div>
      <nav class="cols" aria-label="Footer">
        {columns.map((c) => (
          <div>
            <h2>{c.title}</h2>
            <ul>
              {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="bottom">
      <p>
        © {year} {SITE.name}
        {SITE.email && <> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></>}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: clamp(3.5rem, 7vw, 5rem) 2rem; font-size: 0.9rem; }
  .top { display: grid; gap: 3rem; padding-bottom: 3rem; }
  @media (min-width: 860px) { .top { grid-template-columns: 1.3fr 2fr; } }
  .brand p { margin-top: 1rem; max-width: 18rem; color: var(--ink-3); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 2rem; }
  .cols h2 { font-size: 0.86rem; font-weight: 500; letter-spacing: -0.005em; color: var(--ink); margin-bottom: 1rem; }
  .cols ul { list-style: none; padding: 0; display: grid; gap: 0.65rem; }
  .cols a { color: var(--ink-3); text-decoration: none; }
  .cols a:hover { color: var(--ink); }
  .bottom { padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 0.82rem; }
</style>
