---
// A short centered message page (used for thank-you and 404 pages).
interface Props { eyebrow: string; title: string }
const { eyebrow, title } = Astro.props;
---
<section class="section msg">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <div class="lede"><slot /></div>
    <div class="btn-row">
      <a href="/" class="btn btn--primary">Back to home</a>
      <a href="/research/" class="btn btn--secondary">See the evidence</a>
    </div>
  </div>
</section>

<style>
  .msg { min-height: 60vh; display: grid; align-items: center; text-align: center; }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin-bottom: 1rem; }
  .lede { margin: 0 auto 2rem; }
  .btn-row { justify-content: center; }
</style>
