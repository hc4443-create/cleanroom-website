---
// The wordmark: a small memory-block symbol plus the name from src/config.ts.
import { SITE } from '../config';
interface Props { inverted?: boolean }
const { inverted = false } = Astro.props;
---
<span class:list={['logo', { inverted }]}>
  <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="1.5" y="1.5" width="21" height="21" rx="5" fill="none" stroke="currentColor" stroke-width="1.6" />
    <rect x="6" y="6" width="5" height="5" rx="1.2" class="job" />
    <rect x="13" y="6" width="5" height="5" rx="1.2" class="ai" />
    <rect x="6" y="13" width="5" height="5" rx="1.2" class="ai" />
    <rect x="13" y="13" width="5" height="5" rx="1.2" class="job" />
  </svg>
  <span class="word">{SITE.name}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink); }
  .mark { width: 1.45rem; height: 1.45rem; flex: none; }
  .job { fill: currentColor; opacity: 0.3; }
  .ai { fill: var(--accent); }
  .word { font-size: 1.12rem; font-weight: 640; letter-spacing: -0.045em; }
  .inverted { color: var(--ink); }
</style>
