---
// The closing call to action used at the bottom of most pages.
interface Props { title?: string; text?: string }
const {
  title = 'See how much model your cluster can already hold.',
  text = 'We’ll replay your scheduler history and show you what your cluster could serve.',
} = Astro.props;
---
<section class="section cta">
  <div class="container">
    <div class="box reveal">
      <h2 class="gradient-text">{title}</h2>
      <p class="lede">{text}</p>
      <div class="btn-row">
        <a href="/contact/" class="btn btn--primary">Talk to us <span class="arrow" aria-hidden="true">→</span></a>
        {Astro.url.pathname.startsWith('/how-it-works')
          ? <a href="/research/" class="btn btn--secondary">See the research</a>
          : <a href="/how-it-works/" class="btn btn--secondary">How it works</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta { overflow: hidden; }
  .box {
    position: relative;
    display: grid; justify-items: center; gap: 1.5rem;
    text-align: center;
    padding-block: clamp(1rem, 4vw, 3rem);
  }
  .box::before {
    content: ''; position: absolute; z-index: -1; inset: -40% 10% -10%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(92 209 196 / 0.12), transparent 70%);
    filter: blur(10px);
  }
  h2 { font-size: clamp(2.1rem, 4.6vw, 3.5rem); max-width: 16em; }
  .lede { margin-inline: auto; }
  .btn-row { justify-content: center; margin-top: 0.5rem; }
</style>
