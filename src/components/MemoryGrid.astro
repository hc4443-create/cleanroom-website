---
// The site's signature illustration: four GPUs, each with eight blocks of memory.
//   gray  = memory a research job is using
//   teal  = Cleanroom's AI model, placed in memory that was unused
//   empty = unused memory
//
// state:
//   'before'   research jobs only (memory sits unused)
//   'shared'   Cleanroom fills unused memory
//   'reclaim'  a job needs more memory, and Cleanroom gives it back
//   'animated' plays before → shared → reclaim once, then rests
// This is a conceptual picture, not a technical diagram.

type State = 'before' | 'shared' | 'reclaim' | 'animated';
interface Props { state?: State; size?: 'lg' | 'md'; showLegend?: boolean; showStatus?: boolean }
const { state = 'shared', size = 'md', showLegend = true, showStatus = false } = Astro.props;

const JOBS = [3, 1, 5, 2];         // memory blocks each research job uses (out of 8)
const RECLAIM_GPU = 1;             // the GPU whose job grows
const RECLAIM_TO = 4;              // ...to this many blocks
const CELLS = 8;
const HEADROOM = 1;                // blocks always left free

type Cell = 'job' | 'ai' | 'free' | 'swap';
const gpus = JOBS.map((jobs, g) =>
  Array.from({ length: CELLS }, (_, c): Cell => {
    const isJob = c < jobs;
    const isAi = !isJob && c < CELLS - HEADROOM;
    const isReclaimed = g === RECLAIM_GPU && c >= jobs && c < RECLAIM_TO;
    if (isJob) return 'job';
    if (state === 'before') return 'free';
    if (isReclaimed) return state === 'shared' ? 'ai' : state === 'reclaim' ? 'job' : 'swap';
    return isAi ? 'ai' : 'free';
  })
);

const labels: Record<State, string> = {
  before: 'Four GPUs running research jobs. Most of each GPU’s memory is unused.',
  shared: 'Four GPUs running research jobs. Cleanroom has placed an AI model in the memory the jobs left unused.',
  reclaim: 'One research job needs more memory, and Cleanroom has handed that memory back. The AI model keeps running in the remaining unused memory.',
  animated: 'Animation: research jobs leave GPU memory unused; Cleanroom places an AI model in that memory; when a job needs more memory, Cleanroom hands it back.',
};
let aiIndex = 0;
---
<figure class:list={['mg', `mg--${size}`, `mg--${state}`]}>
  {showStatus && state === 'animated' && (
    <div class="status" aria-hidden="true">
      <span class="s s1"><i class="dot job"></i>Research jobs are running, leaving most memory unused.</span>
      <span class="s s2"><i class="dot ai"></i>Cleanroom places an AI model in the unused memory.</span>
      <span class="s s3"><i class="dot job"></i>A job needs more memory, so Cleanroom hands it back.</span>
    </div>
  )}
  <div class="gpus" role="img" aria-label={labels[state]}>
    {gpus.map((cells, g) => (
      <div class="gpu">
        <div class="cells">
          {cells.map((cell) => {
            const delay = cell === 'ai' || cell === 'swap' ? aiIndex++ : 0;
            return <span class={`cell ${cell}`} style={`--i:${delay}`} />;
          })}
        </div>
        <span class="gpu-label">GPU {g + 1}</span>
      </div>
    ))}
  </div>
  {showLegend && (
    <figcaption class="legend">
      <span><i class="dot job"></i>Research job</span>
      <span><i class="dot ai"></i>Cleanroom AI model</span>
      <span><i class="dot free"></i>Unused memory</span>
    </figcaption>
  )}
</figure>

<style>
  .mg { --cell: 1.6rem; --gap: 0.35rem; }
  .mg--lg { --cell: clamp(1.55rem, 3.6vw, 2.35rem); --gap: clamp(0.3rem, 0.7vw, 0.45rem); }

  .gpus { display: grid; grid-template-columns: repeat(4, auto); justify-content: center; gap: clamp(0.6rem, 2vw, 1.1rem); }
  .gpu {
    display: grid; gap: 0.6rem; justify-items: center;
    padding: calc(var(--gap) * 2);
    padding-bottom: 0.65rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }
  .cells { display: flex; flex-direction: column-reverse; gap: var(--gap); }
  .cell {
    width: calc(var(--cell) * 1.7); height: var(--cell);
    border-radius: 5px;
    border: 1.5px dashed var(--line-strong);
  }
  .cell.job { background: var(--mem-job); border: 0; }
  .cell.ai { background: var(--mem-ai); border: 0; }
  .cell.swap { background: var(--mem-ai); border: 0; }
  .gpu-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }

  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; margin-top: 1.25rem; font-size: 0.85rem; color: var(--ink-2); }
  .legend span, .s { display: inline-flex; align-items: center; gap: 0.45rem; }
  .dot { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; flex: none; }
  .dot.job { background: var(--mem-job); }
  .dot.ai { background: var(--mem-ai); }
  .dot.free { border: 1.5px dashed var(--line-strong); }

  /* Animated version */
  .status { position: relative; height: 1.6rem; margin-bottom: 1.1rem; font-size: 0.9rem; font-weight: 500; color: var(--ink-2); text-align: center; }
  .s { position: absolute; inset: 0; justify-content: center; align-items: flex-start; opacity: 0; }
  .s .dot { margin-top: 0.3rem; }
  @media (max-width: 600px) {
    .status { height: 2.9rem; font-size: 0.85rem; }
    .s .dot { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mg--animated .cell.ai,
    .mg--animated .cell.swap { animation: fill-in 0.5s ease-out both; animation-delay: calc(1.6s + var(--i) * 0.09s); }
    .mg--animated .cell.swap { animation: fill-in 0.5s ease-out both, give-back 0.7s ease-in-out both; animation-delay: calc(1.6s + var(--i) * 0.09s), 5.2s; }
    .s1 { animation: status 1.6s ease both; animation-delay: 0.1s; }
    .s2 { animation: status 3.4s ease both; animation-delay: 1.7s; }
    .s3 { animation: status-final 0.6s ease both; animation-delay: 5.2s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mg--animated .cell.swap { background: var(--mem-job); }
    .s3 { opacity: 1; }
  }
  @keyframes fill-in {
    from { background: transparent; box-shadow: inset 0 0 0 1.5px var(--line-strong); transform: scale(0.92); }
    to { background: var(--mem-ai); transform: none; }
  }
  @keyframes give-back {
    0% { background: var(--mem-ai); }
    45% { background: var(--bg); box-shadow: inset 0 0 0 1.5px var(--mem-job); }
    100% { background: var(--mem-job); }
  }
  @keyframes status { 0% { opacity: 0; transform: translateY(4px); } 12%, 85% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes status-final { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
</style>
