---
// The site's signature illustration: four GPUs, each with eight blocks of memory.
//   gray  = memory a research job is using
//   teal  = Cleanroom's AI model, placed in memory that was unused
//   empty = unused memory
//
// state:
//   'before'       research jobs only (memory sits unused)
//   'shared'       Cleanroom fills unused memory
//   'reclaim'      a job needs more memory, and Cleanroom gives it back
//   'interactive'  plays the three steps once, then visitors can click
//                  through the steps or click a GPU to make its job grow
// This is a conceptual picture, not a technical diagram.

type State = 'before' | 'shared' | 'reclaim' | 'interactive';
interface Props { state?: State; size?: 'lg' | 'md'; showLegend?: boolean }
const { state = 'shared', size = 'md', showLegend = true } = Astro.props;

const JOBS = [3, 1, 5, 2];         // memory blocks each research job uses (out of 8)
const RECLAIM_GPU = 1;             // in step 3, this GPU's job grows...
const RECLAIM_TO = 4;              // ...to this many blocks
const CELLS = 8;
const HEADROOM = 1;                // blocks always left free

// Each cell gets a fixed role; the current step (0, 1 or 2) decides how it looks.
//   job  = always research    ai   = Cleanroom from step 1
//   swap = Cleanroom in step 1, handed back to research in step 2
//   free = always unused
type Role = 'job' | 'ai' | 'swap' | 'free';
let order = 0;
const gpus = JOBS.map((jobs, g) =>
  Array.from({ length: CELLS }, (_, c) => {
    let role: Role = 'free';
    if (c < jobs) role = 'job';
    else if (g === RECLAIM_GPU && c < RECLAIM_TO) role = 'swap';
    else if (c < CELLS - HEADROOM) role = 'ai';
    return { role, i: role === 'ai' || role === 'swap' ? order++ : 0 };
  })
);

const interactive = state === 'interactive';
const step = { before: 0, shared: 1, reclaim: 2, interactive: 2 }[state];

const STEPS = [
  'Research jobs are running, leaving most memory unused.',
  'Cleanroom places an AI model in the unused memory.',
  'A job needs more memory, so Cleanroom hands it back.',
];
const labels = [
  'Four GPUs running research jobs. Most of each GPU’s memory is unused.',
  'Four GPUs running research jobs. Cleanroom has placed an AI model in the memory the jobs left unused.',
  'One research job needs more memory, and Cleanroom has handed that memory back. The AI model keeps running in the remaining unused memory.',
];
---
<figure
  class:list={['mg', `mg--${size}`, { 'mg--interactive': interactive }]}
  data-step={step}
>
  {interactive && (
    <>
      <div class="controls" role="group" aria-label="Show a step">
        {['Jobs run', 'AI fills in', 'Memory returned'].map((label, n) => (
          <button type="button" class="step-btn" data-go={n} aria-pressed={n === step ? 'true' : 'false'}>
            <span class="num">{n + 1}</span>{label}
          </button>
        ))}
      </div>
      <p class="status" aria-live="polite">{STEPS[step]}</p>
    </>
  )}

  <div class="gpus" role="img" aria-label={labels[step]}>
    {gpus.map((cells, g) => {
      const inner = (
        <>
          <div class="cells">
            {cells.map((cell) => <span class={`cell ${cell.role}`} style={`--i:${cell.i}`} />)}
          </div>
          <span class="gpu-label">GPU {g + 1}</span>
        </>
      );
      return interactive
        ? <button type="button" class="gpu" data-gpu={g} aria-label={`GPU ${g + 1}: make its research job use more memory`}>{inner}</button>
        : <div class="gpu">{inner}</div>;
    })}
  </div>

  {showLegend && (
    <figcaption class="legend">
      <span><i class="dot job"></i>Research job</span>
      <span><i class="dot ai"></i>Cleanroom AI model</span>
      <span><i class="dot free"></i>Unused memory</span>
    </figcaption>
  )}
  {interactive && <p class="hint">Try it: click or tap a GPU to give its research job more memory.</p>}
</figure>

{interactive && (
  <script>
    const STEPS = [
      'Research jobs are running, leaving most memory unused.',
      'Cleanroom places an AI model in the unused memory.',
      'A job needs more memory, so Cleanroom hands it back.',
    ];
    document.querySelectorAll<HTMLElement>('.mg--interactive').forEach((fig) => {
      const status = fig.querySelector('.status');
      const buttons = fig.querySelectorAll<HTMLButtonElement>('.step-btn');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let timers: number[] = [];

      const resetGrown = () =>
        fig.querySelectorAll('.cell.grown').forEach((c) => c.classList.remove('grown'));

      const show = (n: number, text = STEPS[n]) => {
        fig.dataset.step = String(n);
        buttons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === n)));
        if (status) status.textContent = text;
      };
      const stopAutoplay = () => { timers.forEach(clearTimeout); timers = []; };

      buttons.forEach((b) =>
        b.addEventListener('click', () => { stopAutoplay(); resetGrown(); show(Number(b.dataset.go)); })
      );

      // Clicking a GPU makes its research job grow by one block. If Cleanroom
      // was using that block, it hands it back.
      fig.querySelectorAll<HTMLButtonElement>('.gpu').forEach((gpu) =>
        gpu.addEventListener('click', () => {
          stopAutoplay();
          if (fig.dataset.step === '0') show(1);
          const cells = [...gpu.querySelectorAll<HTMLElement>('.cell')];
          const isResearch = (c: HTMLElement) =>
            c.classList.contains('job') || c.classList.contains('grown') ||
            (c.classList.contains('swap') && fig.dataset.step === '2');
          const next = cells.find((c) => !isResearch(c) && !c.classList.contains('free'));
          if (next) {
            next.classList.add('grown');
            show(Number(fig.dataset.step), 'A job needs more memory, so Cleanroom hands it back immediately.');
          } else {
            const restored = cells.filter((c) => c.classList.contains('grown'));
            restored.forEach((c) => c.classList.remove('grown'));
            show(Number(fig.dataset.step), 'The job finished with that memory, so Cleanroom can use it again.');
          }
        })
      );

      // Play the three steps once when the page loads.
      if (!reduce) {
        show(0);
        timers.push(window.setTimeout(() => show(1), 1400));
        timers.push(window.setTimeout(() => show(2), 4400));
      }
    });
  </script>
)}

<style>
  .mg { --cell: 1.6rem; --gap: 0.35rem; }
  .mg--lg { --cell: clamp(1.55rem, 3.6vw, 2.35rem); --gap: clamp(0.3rem, 0.7vw, 0.45rem); }

  .gpus { display: grid; grid-template-columns: repeat(4, auto); justify-content: center; gap: clamp(0.6rem, 2vw, 1.1rem); }
  .gpu {
    display: grid; gap: 0.6rem; justify-items: center;
    padding: calc(var(--gap) * 2);
    padding-bottom: 0.65rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
    font: inherit;
  }
  button.gpu { cursor: pointer; transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
  button.gpu:hover { border-color: var(--accent); transform: translateY(-2px); }
  button.gpu:active { transform: translateY(0); }
  .cells { display: flex; flex-direction: column-reverse; gap: var(--gap); }
  .cell {
    width: calc(var(--cell) * 1.7); height: var(--cell);
    border-radius: 5px;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition: background-color 0.45s ease, box-shadow 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--i) * 55ms);
  }
  .cell.job { background: var(--mem-job); box-shadow: none; }
  .free { box-shadow: inset 0 0 0 1.5px var(--line-strong); }

  /* Step 1 and 2: Cleanroom fills the unused memory */
  [data-step='1'] .cell.ai, [data-step='2'] .cell.ai,
  [data-step='1'] .cell.swap { background: var(--mem-ai); box-shadow: none; }
  /* Step 2: one job takes memory back */
  [data-step='2'] .cell.swap { background: var(--mem-job); box-shadow: none; }
  /* A job grown by clicking its GPU */
  .cell.grown, [data-step] .cell.grown { background: var(--mem-job) !important; box-shadow: 0 0 0 2px var(--accent-soft); transition-delay: 0s; }
  [data-step='0'] .cell { transition-delay: 0s; }

  .gpu-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }

  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; margin-top: 1.25rem; font-size: 0.85rem; color: var(--ink-2); }
  .legend span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .dot { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; flex: none; }
  .dot.job { background: var(--mem-job); }
  .dot.ai { background: var(--mem-ai); }
  .dot.free { box-shadow: inset 0 0 0 1.5px var(--line-strong); }

  /* Interactive controls */
  .controls { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; max-width: 26rem; margin: 0 auto 1rem; }
  .step-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    white-space: nowrap;
    padding: 0.4rem 0.6rem 0.4rem 0.4rem;
    border: 1px solid var(--line); border-radius: 999px;
    background: var(--bg); color: var(--ink-2);
    font-size: 0.82rem; font-weight: 500; cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .step-btn:hover { border-color: var(--accent); color: var(--ink); }
  .step-btn .num { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: var(--bg-soft); font-size: 0.72rem; font-weight: 600; }
  .step-btn[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .step-btn[aria-pressed='true'] .num { background: rgb(255 255 255 / 0.2); }
  .status { min-height: 1.6em; margin-bottom: 1rem; text-align: center; font-size: 0.92rem; font-weight: 500; color: var(--ink); }
  .hint { margin-top: 0.6rem; text-align: center; font-size: 0.78rem; color: var(--ink-3); }

  @media (max-width: 600px) {
    .status { min-height: 2.9em; font-size: 0.86rem; }
    .step-btn { font-size: 0.72rem; gap: 0.3rem; padding-right: 0.45rem; }
    .step-btn .num { width: 1.15rem; height: 1.15rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cell, button.gpu, .step-btn { transition: none; }
  }
</style>
