---
import Logo from './Logo.astro';
import { NAV, SITE } from '../config';
import { getCollection } from 'astro:content';

// The "Updates" link only appears once at least one update is published.
const published = await getCollection('updates', ({ data }) => !data.draft);
const links = published.length ? [...NAV, { label: 'Updates', href: '/updates/' }] : NAV;

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="home" aria-label={`${SITE.name} home`}><Logo /></a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="/contact/" class="btn btn--primary nav-cta">Talk to us</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('open', !open);
    // On phones, move keyboard focus into the menu that just opened.
    if (!open) document.querySelector<HTMLElement>('#site-nav a')?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('open')) {
      header.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
  // Add a hairline border once the page scrolls.
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(8 9 10 / 0.72);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .site-header.scrolled { border-bottom-color: var(--line); background: rgb(8 9 10 / 0.85); }
  .bar { display: flex; align-items: center; gap: 1.5rem; height: 4rem; }
  .actions { display: flex; align-items: center; gap: 0.75rem; }
  .home { text-decoration: none; display: inline-flex; }

  .nav { display: flex; align-items: center; margin-left: auto; }
  .nav ul { display: flex; gap: 0.25rem; list-style: none; padding: 0; }
  .nav ul a { display: block; padding: 0.4rem 0.75rem; border-radius: 7px; color: var(--ink-2); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.15s, background-color 0.15s; }
  .nav ul a:hover { color: var(--ink); background: rgb(255 255 255 / 0.05); }
  .nav ul a[aria-current='page'] { color: var(--ink); background: rgb(255 255 255 / 0.06); }
  .nav-cta { min-height: 2.15rem; padding: 0.35rem 0.9rem; font-size: 0.86rem; }

  .menu-btn { display: none; background: none; border: 0; padding: 0.6rem; margin-right: -0.6rem; cursor: pointer; }
  .burger { display: grid; gap: 6px; width: 20px; }
  .burger span { height: 1.5px; background: var(--ink); border-radius: 2px; transition: transform 0.2s; }
  .open .burger span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .open .burger span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  @media (max-width: 899px) {
    .menu-btn { display: grid; place-items: center; min-width: 2.75rem; min-height: 2.75rem; padding: 0; margin-right: -0.6rem; }
    .nav-cta { min-height: 2.75rem; }
    .actions { margin-left: auto; }
    .nav {
      display: none;
      position: absolute; top: 4rem; left: 0; right: 0;
      flex-direction: column; align-items: stretch;
      margin-left: 0;
      padding: 0.25rem var(--gutter) 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .open .nav { display: flex; }
    .open.site-header { background: var(--bg); }
    .nav ul { flex-direction: column; gap: 0; }
    .nav ul a { padding: 0.85rem 0; border-radius: 0; font-size: 1.05rem; border-bottom: 1px solid var(--line); }
    .nav ul a:hover, .nav ul a[aria-current='page'] { background: none; }
    .nav ul a[aria-current='page'] { color: var(--accent-ink); }
    .nav ul li:last-child a { border-bottom: 0; }
  }
</style>
