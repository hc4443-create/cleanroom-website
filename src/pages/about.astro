---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import { TEAM } from '../data/team';
import { SITE } from '../config';

const N = SITE.name;

const initials = (name: string) => name.split(' ').map((p) => p[0]).join('').slice(0, 2);
---
<BaseLayout
  title="About"
  description={`${N} turns the spare GPU memory on HPC clusters into a private AI inference service. Meet the team.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About {N}</span>
      <h1>Most GPU clusters already have room for an AI service.</h1>
      <p class="lede">
        Organizations that run simulations have spent millions on GPUs whose memory sits mostly empty, while their
        people wait for AI they can’t afford to host. {N} closes that gap: large models served from spare memory,
        with the host job always first.
      </p>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Team</span>
        <h2>The founders</h2>
      </div>
      <div class="lines lines--2 people">
        {TEAM.map((p) => (
          <article class="person">
            {p.photo
              ? <img class="avatar" src={p.photo} alt="" width="72" height="72" loading="lazy" />
              : <span class="avatar initials" aria-hidden="true">{initials(p.name)}</span>}
            <div>
              <h3>{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.name}</a> : p.name}</h3>
              <p class="role">{p.role}</p>
              <p class="school">{p.school}</p>
              <p class="bio">{p.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- COLLABORATE -->
  <section class="section">
    <div class="container split collab">
      <div>
        <span class="eyebrow">Work with us</span>
        <h2>Researchers and engineers: let’s talk.</h2>
      </div>
      <div>
        <p class="lede">If you work on GPU systems, HPC, inference or research computing and this problem interests you, we’d like to hear from you as a possible collaborator, advisor or future teammate.</p>
        <p style="margin-top:1.5rem"><a href="/contact/" class="btn btn--secondary">Get in touch <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .person { display: flex; gap: 1.5rem; align-items: flex-start; }
  .avatar { width: 4.5rem; height: 4.5rem; border-radius: 50%; flex: none; object-fit: cover; }
  .initials { display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--line-strong); color: var(--ink); font-family: var(--font-sans); font-size: 1.5rem; font-weight: 600; }
  .person h3 { margin-bottom: 0.2rem; }
  .person h3 a { color: inherit; }
  .role { color: var(--ink) !important; font-weight: 550; }
  .school { font-size: 0.92rem; margin-bottom: 0.8rem; }
  @media (max-width: 480px) { .person { flex-direction: column; } }


  .collab { align-items: start; }
</style>
