---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import { TEAM } from '../data/team';

const initials = (name: string) => name.split(' ').map((p) => p[0]).join('').slice(0, 2);
---
<BaseLayout
  title="About"
  description="Cleanroom is building private, campus-wide AI on the GPU clusters research institutions already own. Meet the team and see where we are."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About Cleanroom</span>
      <h1>Every research institution should be able to offer its researchers private AI.</h1>
      <p class="lede">
        Cleanroom lets universities and research institutions run private AI on the GPU clusters they already own, by
        placing AI models in GPU memory that research jobs leave unused. No new hardware, no per-use cloud bills, and data stays on campus.
      </p>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Team</span>
        <h2>The founders</h2>
      </div>
      <div class="grid grid--2">
        {TEAM.map((p) => (
          <article class="card person">
            {p.photo
              ? <img class="avatar" src={p.photo} alt="" width="72" height="72" loading="lazy" />
              : <span class="avatar initials" aria-hidden="true">{initials(p.name)}</span>}
            <div>
              <h3>{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.name}</a> : p.name}</h3>
              <p class="role">{p.role}</p>
              <p class="school">{p.school}</p>
              <p class="bio">{p.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRESS -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Where we are</span>
        <h2>Universities want campus AI. Our next step is showing that shared memory doesn't slow research down.</h2>
      </div>
      <ol class="timeline">
        <li>
          <span class="tag tag--muted">Demand</span>
          <h3>Universities are building it themselves</h3>
          <p>Universities such as UC San Diego and the University of Michigan have built their own campus AI services, and research computing teams we've spoken with explained why.</p>
        </li>
        <li>
          <span class="tag tag--muted">Data</span>
          <h3>The unused memory is real</h3>
          <p>Our analysis of 62,827 GPU-hours on a U.S. research university cluster found that 56% peaked at a quarter or less of GPU memory. We also have requests for GPU usage data in progress at other universities. <a href="/research/">See the evidence</a>.</p>
        </li>
        <li>
          <span class="tag">Next</span>
          <h3>A controlled experiment</h3>
          <p>We're running research software alongside AI models to measure slowdown (our target is under 5%), response time, and how safely memory is handed back.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- COLLABORATE -->
  <section class="section">
    <div class="container split collab">
      <div>
        <span class="eyebrow">Work with us</span>
        <h2>Researchers and engineers: let's talk.</h2>
      </div>
      <div>
        <p class="lede">If you work on GPU systems, HPC or research computing and this problem interests you, we'd like to hear from you as a possible collaborator, advisor or future teammate.</p>
        <p style="margin-top:1.5rem"><a href="/contact/" class="btn btn--secondary">Get in touch <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .person { display: flex; gap: 1.5rem; align-items: flex-start; }
  .avatar { width: 4.5rem; height: 4.5rem; border-radius: 50%; flex: none; object-fit: cover; }
  .initials { display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-ink); font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; }
  .person h3 { margin-bottom: 0.2rem; }
  .person h3 a { color: inherit; }
  .role { color: var(--ink) !important; font-weight: 550; }
  .school { font-size: 0.92rem; margin-bottom: 0.8rem; }
  @media (max-width: 480px) { .person { flex-direction: column; } }

  .timeline { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 860px) { .timeline { grid-template-columns: repeat(3, 1fr); } }
  .timeline li { background: var(--bg); padding: 1.75rem; border-radius: var(--radius); box-shadow: var(--shadow); }
  .timeline h3 { margin: 1rem 0 0.5rem; }
  .timeline p { color: var(--ink-2); }

  .collab { align-items: start; }
</style>
