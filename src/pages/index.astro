---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemoryGrid from '../components/MemoryGrid.astro';
import ClusterConsole from '../components/ClusterConsole.astro';
import CTABand from '../components/CTABand.astro';
import { SITE } from '../config';
import { IDLE_MEMORY, BUSY_BUT_EMPTY } from '../data/research';

const N = SITE.name;

const stats = [IDLE_MEMORY[0], IDLE_MEMORY[1], BUSY_BUT_EMPTY[0]];

// The big statement scrolls in word by word (see .scrub in global.css).
const words = (t: string) => t.split(' ');
const statementLead = 'About half of GPU jobs on a leading U.S. supercomputer use a quarter of their memory or less.';
const statementPunch = `${N} turns that empty memory into an AI service, without touching the jobs.`;

const worksWith = ['Slurm', 'NVIDIA A100 · H100 · GH200', 'InfiniBand', 'Apptainer', 'OpenAI API', 'Open WebUI'];

const steps = [
  { state: 'before', title: 'Jobs run as usual', text: 'Slurm schedules your simulations exactly as it does today. Many leave most of each GPU’s memory empty.' },
  { state: 'shared', title: 'Models fill the gaps', text: `${N} loads a large model into that spare memory, pooled across the cluster.` },
  { state: 'reclaim', title: 'The host job always wins', text: 'When a job needs memory back, it gets it within milliseconds. Requests keep being answered.' },
] as const;

const safety = [
  { title: 'Memory back in milliseconds', text: 'A watchdog on every node frees borrowed memory the moment a job grows. Nothing has to be saved or moved first.' },
  { title: 'A slowdown budget you set', text: 'A governor watches each host job and backs off long before it reaches the limit you choose.' },
  { title: 'Isolated from your jobs', text: `${N} runs in its own process on each GPU. A fault on our side never reaches your simulation.` },
  { title: 'Opt in, one level at a time', text: 'Start with idle GPUs, then storage on busy GPUs, then compute. A kill switch works per job, node or site.' },
];

const audiences = [
  { name: 'HPC centers', detail: 'Universities and national labs' },
  { name: 'Biotech and drug discovery', detail: 'Molecular dynamics, docking' },
  { name: 'Engineering simulation', detail: 'Fluid dynamics, crash, materials' },
  { name: 'Energy', detail: 'Seismic and reservoir modeling' },
];
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <a href="/open-source/" class="pill"><b>New</b> Open-source core, Apache-2.0 <span aria-hidden="true">→</span></a>
      <h1 class="gradient-text">Your GPUs are busy.<br />The memory inside them&nbsp;isn’t.</h1>
      <div class="hero-row">
        <p class="lede">
          {N} serves large AI models from the GPU memory your simulations leave empty, and hands it back the moment
          a job needs it. A private inference service on the cluster you already run.
        </p>
        <div class="btn-row">
          <a href="/contact/" class="btn btn--primary">Talk to us <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/how-it-works/" class="btn btn--secondary">How it works</a>
        </div>
      </div>
      <div class="hero-visual">
        <ClusterConsole />
      </div>
    </div>
  </section>

  <!-- WORKS WITH -->
  <section class="works" aria-label="Works with">
    <div class="container works-row">
      <p class="caption">Works with the stack you already run</p>
      <ul>
        {worksWith.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="section">
    <div class="container">
      <p class="statement scrub">
        {words(statementLead).map((w) => <span class="w">{w} </span>)}
        <strong>{words(statementPunch).map((w) => <span class="w">{w} </span>)}</strong>
      </p>
      <div class="lines lines--3 stats reveal">
        {stats.map((s) => (
          <div>
            <p class="n">{s.stat}</p>
            <p>{s.label}.</p>
            <a class="src" href={s.source.url} target="_blank" rel="noopener">{s.short} ↗</a>
          </div>
        ))}
      </div>
      <a href="/research/" class="link-arrow more">See the research <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>Your simulations keep running. {N} uses what’s left over.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="card reveal">
            <div class="viz"><MemoryGrid state={s.state} showLegend={false} /></div>
            <span class="num">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="legend-row">
        <span><i class="k job"></i>HPC job</span>
        <span><i class="k ai"></i>AI model</span>
        <span><i class="k free"></i>Unused memory</span>
        <span><i class="k back"></i>Handed back to the job</span>
      </div>
      <a href="/how-it-works/" class="link-arrow">More on how it works <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- SAFETY -->
  <section class="section dark">
    <div class="container split safety-wrap">
      <div class="reveal">
        <span class="eyebrow">Built for HPC operators</span>
        <h2>We’re the guest.<br />Your job is the&nbsp;host.</h2>
        <p class="lede">Every part of {N} is built around one rule: the host job always comes first.</p>
        <a href="/how-it-works/#safety" class="link-arrow">How we protect host jobs <span aria-hidden="true">→</span></a>
      </div>
      <ul class="lines lines--2 safety reveal">
        {safety.map((s, i) => (
          <li>
            <span class="num">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FOR YOUR USERS -->
  <section class="section">
    <div class="container split api">
      <div class="reveal">
        <span class="eyebrow">For your users</span>
        <h2>Point the tools they already use at your cluster.</h2>
        <p class="lede">An OpenAI-compatible API means existing SDKs, notebooks and agent frameworks work as-is. Keys, budgets and single sign-on are set per project, and the data stays on your hardware.</p>
      </div>
      <pre class="code reveal" aria-label="Example: pointing the OpenAI Python client at your cluster"><code><span class="c-k">from</span> openai <span class="c-k">import</span> OpenAI

client = OpenAI(
    base_url=<span class="c-s">"https://ai.example.org/v1"</span>,
    api_key=<span class="c-s">"YOUR_KEY"</span>,
)
resp = client.chat.completions.create(
    model=<span class="c-s">"deepseek-v3"</span>,
    messages=[{"{"}<span class="c-s">"role"</span>: <span class="c-s">"user"</span>,
               <span class="c-s">"content"</span>: prompt{"}"}],
)</code></pre>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="section">
    <div class="container split who">
      <div class="reveal">
        <span class="eyebrow">Who it’s for</span>
        <h2>Anyone who runs simulations on their own GPUs.</h2>
        <p class="lede">What matters is what your GPUs run, not who owns them. Simulation codes tend to leave memory empty, and that’s where {N} works.</p>
      </div>
      <ul class="aud reveal">
        {audiences.map((a) => (
          <li><span class="nm">{a.name}</span><span class="d">{a.detail}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- OPEN SOURCE -->
  <section class="section">
    <div class="container">
      <div class="oss card reveal">
        <div>
          <span class="eyebrow">Open source</span>
          <h2>Read the code that gives your jobs their memory back.</h2>
          <p class="lede">The memory safety code, telemetry agent and single-node engine are Apache-2.0. The enterprise edition pools memory across the whole cluster.</p>
        </div>
        <div class="oss-cta">
          <a href="/open-source/" class="btn btn--secondary">Open source vs. enterprise <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .hero { padding-top: clamp(4rem, 9vw, 6.5rem); padding-bottom: clamp(1rem, 3vw, 2rem); overflow: hidden; }
  .hero .pill { margin-bottom: 2rem; }
  .hero h1 { font-size: clamp(2.6rem, 6.6vw, 5.1rem); max-width: 15em; }
  .hero-row { display: grid; gap: 2rem; margin-top: 2rem; align-items: end; }
  @media (min-width: 960px) { .hero-row { grid-template-columns: 1.2fr auto; } }
  .hero-visual { margin-top: clamp(3rem, 6vw, 4.5rem); }

  .works { border-block: 1px solid var(--line); }
  .works-row { display: grid; gap: 1rem; padding-block: 1.75rem; align-items: center; }
  @media (min-width: 960px) { .works-row { grid-template-columns: auto 1fr; gap: 3rem; } }
  .works ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem 2.25rem; }
  .works li { font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink-2); }
  .works + .section { border-top: 0; }

  .statement { font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.2; letter-spacing: -0.03em; font-weight: 550; color: var(--ink-3); max-width: 24em; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .statement strong { color: var(--ink); font-weight: 550; }
  .stats .n { font-size: clamp(2.6rem, 5vw, 3.75rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1; color: var(--ink); margin-bottom: 0.85rem; }
  .stats p { max-width: 20em; }
  .src { display: inline-block; margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-3); text-decoration: none; }
  .src:hover { color: var(--accent); }
  .more { margin-top: 2.5rem; }

  .steps { list-style: none; padding: 0; display: grid; gap: 1rem; margin-bottom: 1.5rem; }
  @media (min-width: 960px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .steps .viz :global(.mg) { --cell: clamp(0.9rem, 1.5vw, 1.25rem); --gap: 0.28rem; }
  .steps .viz :global(.gpus) { gap: clamp(0.4rem, 1vw, 0.75rem); }
  .steps .viz { padding: 1.5rem 0.5rem; margin-bottom: 1.5rem; border-radius: 10px; background: rgb(0 0 0 / 0.25); border: 1px solid var(--line); }
  .steps .num { display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-3); margin-bottom: 0.6rem; }
  .legend-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 2.5rem; font-size: 0.85rem; color: var(--ink-2); }
  .legend-row span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .k { width: 0.8rem; height: 0.8rem; border-radius: 3px; }
  .k.job { background: var(--mem-job); }
  .k.ai { background: var(--mem-ai); }
  .k.free { box-shadow: inset 0 0 0 1px var(--line-strong); }
  .k.back { background: var(--mem-job); box-shadow: inset 0 0 0 2px var(--mem-back); }

  .safety-wrap { align-items: start; }
  @media (min-width: 960px) { .safety-wrap { grid-template-columns: 0.85fr 1.15fr; } }
  .safety-wrap h2 { margin-bottom: 1.25rem; }
  .safety-wrap .lede { margin-bottom: 1.75rem; }
  .safety { list-style: none; padding: 0; }
  .safety p { font-size: 0.95rem; }

  .steps > *, .hero-row > * { min-width: 0; }
  .api h2 { margin-bottom: 1.25rem; }
  .code {
    margin: 0; padding: 1.25rem 1.35rem; overflow-x: auto;
    border-radius: 10px; border: 1px solid var(--line);
    background: rgb(0 0 0 / 0.35);
    font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.7; color: var(--ink-2);
  }
  .c-k { color: #c49cff; }
  .c-s { color: var(--accent); }

  .who { align-items: start; }
  .who h2 { margin-bottom: 1.25rem; }
  .aud { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .aud li { display: grid; gap: 0.3rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .aud .nm { font-size: clamp(1.25rem, 2.2vw, 1.6rem); font-weight: 600; letter-spacing: -0.03em; color: var(--ink); }
  .aud .d { color: var(--ink-3); font-size: 0.92rem; }

  .oss { display: grid; gap: 2rem; align-items: end; padding: clamp(2rem, 5vw, 3.5rem); background: radial-gradient(600px 300px at 0% 0%, rgb(92 209 196 / 0.08), transparent 70%), linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)); }
  @media (min-width: 900px) { .oss { grid-template-columns: 1.6fr auto; } }
  .oss h2 { font-size: clamp(1.75rem, 3.4vw, 2.5rem); margin-bottom: 1rem; }
</style>
