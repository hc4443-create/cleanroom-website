---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
const updated = 'November 2026';
---
<BaseLayout title="Privacy" description="How Cleanroom handles information you share through this website.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Privacy</span>
      <h1>Privacy note</h1>
      <p class="lede">Last updated {updated}.</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>What we collect</h2>
      <p>We only collect what you choose to send us:</p>
      <ul>
        <li><strong>Contact form:</strong> your name, email, institution, role and message.</li>
        <li><strong>Mailing list:</strong> your email address.</li>
      </ul>
      <p>This site does not use advertising or tracking cookies.</p>

      <h2>How we use it</h2>
      <p>We use your information only to reply to you and, if you subscribed, to send occasional updates about Cleanroom. We do not sell or share it with third parties for marketing.</p>

      <h2>Where it is stored</h2>
      <p>The website and its forms are hosted by Netlify, which stores form submissions on our behalf. Like most web hosts, Netlify may keep basic technical logs (such as IP addresses) to run and secure the service.</p>

      <h2>Your choices</h2>
      <p>
        You can ask us to remove you from the mailing list or delete your information at any time
        {SITE.email ? <>by emailing <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</> : <>through our <a href="/contact/">contact form</a>.</>}
      </p>
    </div>
  </section>
</BaseLayout>
