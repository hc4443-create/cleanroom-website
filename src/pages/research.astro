---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import { SITE } from '../config';
import { SOURCES, IDLE_MEMORY, BUSY_BUT_EMPTY, MOE_FIT, DEMAND } from '../data/research';

const N = SITE.name;
const sources = Object.values(SOURCES);
---
<BaseLayout
  title="Research"
  description="Published studies of large HPC systems show GPUs stay busy while most of their memory sits empty. Large mixture-of-experts models need exactly the opposite."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Research</span>
      <h1>HPC clusters leave most of their GPU memory empty.</h1>
      <p class="lede">
        Peer-reviewed studies of large HPC systems agree: many GPU jobs need a GPU’s compute but not its memory. That
        unused memory is where {N} runs.
      </p>
    </div>
  </section>

  <!-- IDLE MEMORY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Idle memory</span>
        <h2>On large HPC systems, the typical GPU job uses a fraction of its memory.</h2>
        <p class="lede">Two independent studies, one of NERSC’s Perlmutter and one covering 118,276 jobs, find the same pattern.</p>
      </div>
      <div class="lines lines--3 figs">
        {IDLE_MEMORY.map((f, i) => (
          <div class:list={{ lead: i === 0 }}>
            <p class="n">{f.stat}</p>
            <p>{f.label}. <a href={f.source.url} target="_blank" rel="noopener">{f.short}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUSY BUT EMPTY -->
  <section class="section dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Busy compute, empty memory</span>
        <h2>The GPUs are working. Their memory isn’t.</h2>
        <p class="lede">These aren’t idle GPUs. Most of them are busy running simulations that simply don’t need much memory, so whole-GPU sharing tools can’t reach the space they leave.</p>
      </div>
      <div class="lines lines--3 figs">
        {BUSY_BUT_EMPTY.map((f) => (
          <div>
            <p class="n">{f.stat}</p>
            <p>{f.label}. <a href={f.source.url} target="_blank" rel="noopener">{f.short}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MOE FIT -->
  <section class="section">
    <div class="container split fit">
      <div>
        <span class="eyebrow">The right tenant</span>
        <h2><span class="nw">Mixture-of-experts</span> models need the opposite.</h2>
        <p class="lede">
          The largest open models are mostly experts: huge in memory, light on compute, and used a few at a time. They
          fit the space simulations leave behind.
        </p>
        <p class="caption">Figures for DeepSeek-V3 from its <a href={SOURCES.deepseek.url} target="_blank" rel="noopener">technical report</a>.</p>
      </div>
      <div class="lines figs">
        {MOE_FIT.map((f) => (
          <div>
            <p class="n">{f.stat}</p>
            <p>{f.label}.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DEMAND -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why now</span>
        <h2>Demand for in-house AI is rising, and memory keeps getting more expensive.</h2>
      </div>
      <ul class="lines lines--2 demand">
        {DEMAND.map((d) => (
          <li>
            <h3>{d.title}</h3>
            <p>{d.text} <a href={d.source.url} target="_blank" rel="noopener">{d.source.venue}</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SOURCES -->
  <section class="section section--tight">
    <div class="container">
      <h2 class="h3">Sources</h2>
      <ol class="sources small">
        {sources.map((s) => (
          <li>
            {'authors' in s && s.authors && <>{s.authors}, </>}“<a href={s.url} target="_blank" rel="noopener">{s.title}</a>,” {s.venue}.
            {'preprint' in s && s.preprint && <> (<a href={s.preprint} target="_blank" rel="noopener">free preprint</a>)</>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTABand title="Want to see what your own cluster looks like?" text="Our simulator replays your scheduler history and shows how much spare GPU memory you have, hour by hour, and which models it could serve." />
</BaseLayout>

<style>
  .figs .n { font-size: clamp(2.4rem, 4.5vw, 3.25rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1; margin-bottom: 0.85rem; color: var(--ink); }
  .figs p:last-child { color: var(--ink-2); font-size: 0.98rem; max-width: 22em; }
  .figs .lead .n { color: var(--accent-ink); }
  .demand { list-style: none; padding: 0; }
  .demand p { font-size: 0.98rem; }

  .fit { align-items: center; }
  .nw { white-space: nowrap; }
  .fit h2 { margin-bottom: 1.1rem; }
  .fit .lede { margin-bottom: 1rem; }

  .h3 { font-size: 1.3rem; margin-bottom: 0.9rem; }
  .sources { padding-left: 1.2rem; display: grid; gap: 0.6rem; color: var(--ink-2); max-width: 52rem; }
</style>
